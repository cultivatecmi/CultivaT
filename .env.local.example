# Copia este archivo como .env.local y rellena los valores.
# Si los dejas vacíos, CultivaT funciona 100 % con localStorage (sin nube).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Guía IA "Sabi" (opcional, https://aistudio.google.com/apikey) ---
# Sin clave, Sabi usa respuestas educativas preprogramadas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
